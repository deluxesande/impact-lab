# Copy this file to `.env.local` and fill in real values.
#
# `.env*` is gitignored (this template is the one exception). Never commit real
# secrets, and never expose server-only keys to client code.

# --- Clerk API keys ---------------------------------------------------------
# From https://dashboard.clerk.com → your app → Configure → API keys.
# Required at runtime: the proxy middleware (src/proxy.ts) runs on every
# request and throws without these.
#
# Safe to expose to the browser (starts with pk_test_ / pk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY — never import this into client code (starts with sk_test_ / sk_live_).
CLERK_SECRET_KEY=

# --- Auth dev bypass (LOCAL/CI ONLY) ----------------------------------------
# Set to 1 to skip Clerk session verification in API routes and take the
# caller's identity from x-dev-user-id / x-dev-role headers instead. Never set
# this in production. Leave unset for real Clerk enforcement.
AUTH_DEV_BYPASS=

# --- Clerk route configuration ----------------------------------------------
# Where Clerk's <SignInButton>/<SignUpButton> and redirects send users.
# These match the catch-all pages in src/app/sign-in and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Postgres ---------------------------------------------------------------
# Backs conversations, messages, and the agent_runs refinement log.
# Matches the docker-compose defaults. Change credentials for any deployment
# that is not a throwaway local stack.
DATABASE_URL=postgres://impactlab:impactlab@localhost:5432/impactlab

# Consumed by docker-compose (optional; defaults shown).
POSTGRES_USER=impactlab
POSTGRES_PASSWORD=impactlab
POSTGRES_DB=impactlab
POSTGRES_PORT=5432

# --- MinIO (private object storage for produce photos) ----------------------
# The bucket is private; images are served only via short-lived presigned URLs.

# How THIS SERVER reaches MinIO. On a deployed stack this is usually internal
# — e.g. the docker-compose service name `minio`, or localhost.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=produce
MINIO_CONSOLE_PORT=9001

# How the OUTSIDE WORLD reaches MinIO — used only to sign presigned URLs.
#
# IMPORTANT for deployment: a presigned URL embeds the signing host and the
# signature covers it, so it cannot be rewritten later. If these are left
# unset they fall back to MINIO_ENDPOINT above — fine locally, but on a server
# that means the Android app receives `http://minio:9000/...` or
# `http://localhost:9000/...` (i.e. the phone itself) and every image fails.
#
# Set these to a host reachable from client devices, e.g.
#   MINIO_PUBLIC_ENDPOINT=storage.impact-lab.example.com
#   MINIO_PUBLIC_PORT=443
#   MINIO_PUBLIC_USE_SSL=true
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=
MINIO_PUBLIC_USE_SSL=

# --- AI model providers -----------------------------------------------------
# Fallback chain order: Gemini -> Groq -> OpenAI. A provider is used only if its
# key is set; absent providers are skipped. With none set, the AI endpoints
# fall back to a deterministic heuristic.
GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini

# --- Shamba Records (market data; HMAC-signed, server-only) -----------------
# Keys from the Shamba dashboard. Secret must never reach client code.
# Base URL: sandbox by default; switch to https://api-data.shambarecords.com
# for production.
SHAMBA_BASE_URL=https://api-sandbox.shambarecords.com
SHAMBA_API_KEY=
SHAMBA_API_SECRET=
