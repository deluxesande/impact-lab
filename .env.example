# Copy to .env.local and fill in real values. .env* is gitignored — never
# commit real secrets, and never expose server-only keys to client code.

# --- Clerk (auth) ---------------------------------------------------------
# From https://dashboard.clerk.com. Required at runtime: the proxy middleware
# (src/proxy.ts) runs on every request and throws without these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Postgres (Phase 2) ---------------------------------------------------
# Matches the docker-compose defaults. Change credentials for any deployment
# that is not a throwaway local stack.
DATABASE_URL=postgres://impactlab:impactlab@localhost:5432/impactlab

# Consumed by docker-compose (optional; defaults shown).
POSTGRES_USER=impactlab
POSTGRES_PASSWORD=impactlab
POSTGRES_DB=impactlab
POSTGRES_PORT=5432

# --- MinIO (Phase 2.5, not yet wired) -------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=produce

# --- AI model providers (Phase 3, not yet wired) --------------------------
# Fallback chain order: Gemini -> Groq -> OpenAI.
GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Shamba Records (Phase 3, not yet wired) ------------------------------
SHAMBA_API_PUBLIC_KEY=
SHAMBA_API_SECRET_KEY=

# Copy this file to `.env.local` and fill in the values from your Clerk dashboard:
# https://dashboard.clerk.com → your app → Configure → API keys
#
# `.env.local` is gitignored. Never commit real keys.

# --- Clerk API keys ---------------------------------------------------------
# Safe to expose to the browser (starts with pk_test_ / pk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY — never import this into client code (starts with sk_test_ / sk_live_).
CLERK_SECRET_KEY=

# --- Clerk route configuration ----------------------------------------------
# Where Clerk's <SignInButton>/<SignUpButton> and redirects send users.
# These match the catch-all pages in src/app/sign-in and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
